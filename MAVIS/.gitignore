# Python virtual environments
ai-instructor/.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Downloaded model checkpoints
ai-instructor/data/models/ecapa/*.ckpt

# Downloaded 3D assets (large binaries — keep locally, don't commit).
# cockpit.glb (the preflight/cockpit walk-around model) goes here.
ai-instructor/web/static/models/*
!ai-instructor/web/static/models/.gitkeep


# Runtime-generated state
ai-instructor/data/recordings/last_run.json

# Local session notes for Claude Code (not shared)
CLAUDE.md
report.md
report.docx
MAVIS_AI_Instructor.pptx
# Supabase telemetry exports (raw trainee data, local only)
ai-instructor/data/recordings/supabase/
# Replay placeholders: the logged flight + its screen recording (raw trainee data, large)
ai-instructor/data/recordings/replay/
# Runtime state with credentials / biometrics (seeded or enrolled on first run)
ai-instructor/data/instructors.json
ai-instructor/data/voices/*
!ai-instructor/data/voices/.gitkeep
# Office lock files
~$*
