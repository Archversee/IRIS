# Local Postgres (see README.md §1). This matches config.py's built-in
# default exactly, so it also works if you never copy this to .env at all
# — only edit/copy it if your local Postgres password or port differ.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# CORS: the frontend dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Where recorded/uploaded videos live (relative to backend/ by default)
VIDEO_DIR=../data/videos

# Base URL used to build absolute /videos/... links in API responses
PUBLIC_BASE_URL=http://localhost:8000

# MAVIS's WebSocket state feed — the mavis_bridge background task connects
# here to pull telemetry/coaching/scorecard/leaderboard data into Postgres.
# See docs/INTEGRATION_PLAN.md.
MAVIS_WS_URL=ws://localhost:6945/ws
