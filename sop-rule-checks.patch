+.rc-pill.assess { color: var(--rev-violet); }
+.rc-pill.na { color: var(--rev-muted); }
+.rc-sev { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--rev-muted); }
+.rc-sev.warning { color: #ff5c5c; }
+.rc-overruled { font-size: 11px; color: var(--rev-violet); border: 1px dashed var(--rev-violet); border-radius: 4px; padding: 0 4px; }
+.rc-sum { margin-top: 4px; color: var(--rev-text); }
+.rc-req { font-variant-numeric: tabular-nums; color: var(--rev-muted); margin-right: 4px; }
+.rc-note { margin-top: 4px; color: var(--rev-violet); }
+.rc-viol { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
+.rc-vbtn {
+  font: inherit; font-size: 12px; cursor: pointer; padding: 1px 8px; border-radius: 999px;
+  background: transparent; border: 1px solid #ff5c5c; color: #ff8a8a;
+}
+.rc-detail { margin-top: 6px; }
+.rc-detail blockquote { margin: 0 0 4px; padding-left: 10px; border-left: 2px solid var(--rev-line); color: var(--rev-muted); }
+.rc-judge { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 8px; }
+.rc-judge input { flex: 1; min-width: 140px; }
+.rc-signoff textarea { width: 100%; resize: vertical; }
+.rc-row { display: flex; gap: 8px; margin-top: 8px; }
